# PostgreSQL connection
DATABASE_URL=postgres://rve:change-me@localhost:5432/rve
PORT=8080
# Secret used to sign app access tokens (32+ random bytes, base64)
JWT_SECRET=change-me-long-random
# QR signing keys by version, JSON object. Add a new version to rotate.
QR_KEYS={"1":"change-me-qr-secret"}
# Admin API token for ETAM's admin panel / scripts
ADMIN_TOKEN=change-me-admin
# Timezone used to decide "same day" for repeat check-ins
NETWORK_TZ=Europe/Athens
