# Generate secrets with: openssl rand -base64 48

# PostgreSQL connection
DATABASE_URL=postgres://rve:change-me@localhost:5432/rve
PORT=8080
# Address to listen on. 127.0.0.1 = only nginx on the same server can reach it; 0.0.0.0 = all interfaces (e.g. in Docker).
HOST=127.0.0.1
# Signs app access tokens. At least 32 characters.
JWT_SECRET=
# QR signing keys by version, JSON object, keys of 16+ characters. Add a higher version to rotate;
# new QR codes use the highest version, old printed codes keep working while their version is listed.
QR_KEYS={"1":""}
# Admin panel (/admin) and admin API token for ETAM. At least 24 characters.
ADMIN_TOKEN=
# Timezone used to decide "same day" for repeat check-ins
NETWORK_TZ=Europe/Athens
# Content source (WordPress) and the shared secret used by the rve-sync plugin (16+ characters)
RURALGREECE_URL=https://ruralgreece.gr
WP_WEBHOOK_SECRET=
# Email for login codes. Without SMTP_URL the codes are only written to the log.
SMTP_URL=smtps://user:password@mail.example.gr:465
MAIL_FROM=Rural Greece <no-reply@ruralgreece.gr>
# Set to 1 when running behind nginx, so per-IP limits see the real client address
TRUST_PROXY=1
