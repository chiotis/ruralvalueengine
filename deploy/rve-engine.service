# systemd unit for the Rural Value Engine on lighthouse03.
# Install: sudo cp deploy/rve-engine.service /etc/systemd/system/ && sudo systemctl daemon-reload
#          sudo systemctl enable --now rve-engine
[Unit]
Description=Rural Value Engine (API for the Rural Greece app)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=rve
Group=rve
WorkingDirectory=/opt/rve/engine
EnvironmentFile=/etc/rve/engine.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/rve
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
